{
  "manifest_version": 3,
  "name": "瓷之器",
  "version": "1.5.0",
  "description": "为 HDWinG (hdwing.org) 新增界面主题：暗夜、Nord、纸墨、松烟与青花瓷、梅子青、胭脂红、曜变、陶土、哥窑、天青、钧天、定窑、青瓶、宣德十一款深度定制，深色文字全量精修，支持跟随系统与自定义 CSS，即时切换免刷新。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://*.hdwing.org/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.hdwing.org/*"
      ],
      "js": [
        "shared/themes.js",
        "content/theme.js"
      ],
      "css": [
        "content/core.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/flags/*.webp"
      ],
      "matches": [
        "*://*.hdwing.org/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "瓷之器"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
